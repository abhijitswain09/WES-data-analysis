manifest {
    name = 'abhijitswain09/WES-data-analysis'
    author = 'Abhijit Swain'
    homePage = 'https://github.com/abhijitswain09/WES-data-analysis'
    description = 'Paired-end whole-exome sequencing germline variant-calling workflow'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version = '1.0.0'
}
params {
    input = null
    fasta = null
    intervals = null
    known_sites = null
    known_sites_index = null
    outdir = 'results'
    min_length = 30
    joint_genotyping = false
}
process {
    cpus = 2
    memory = 4.GB
    time = 8.h
    withLabel: process_low { cpus = 2; memory = 4.GB }
    withLabel: process_medium { cpus = 4; memory = 16.GB }
    withLabel: process_high { cpus = 8; memory = 32.GB }
    publishDir = [path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" }, mode: 'copy']
}
profiles {
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
    docker {
        docker.enabled = true
        wave.enabled = true
        wave.strategy = ['conda']
    }
}
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
